# Send only the files consumed by Dockerfile. This is a separate privacy boundary
# from Git and intentionally excludes local control, evidence, source, and design
# material even when a future Dockerfile continues to use explicit COPY commands.
**

!Dockerfile
!.dockerignore
!requirements.lock

!apps/
!apps/api/
!apps/api/**
!apps/web/
!apps/web/**

!config/
!config/**
!prompts/
!prompts/**

!data/
!data/demo_seed/
!data/demo_seed/offgrid_demo_seed.db

!docker/
!docker/entrypoint.sh

# Re-exclude generated and machine-local content nested inside allowed trees.
**/__pycache__/
**/*.py[cod]
apps/web/node_modules/
apps/web/dist/
**/.env
**/.env.*
**/*.log
**/*.sqlite-shm
**/*.sqlite-wal
