/context/
/hydration/
/instructions/
/jira/
/project/
/research/
/release/
/template/

# Keep these explicit entries for the repository privacy validator as well as
# the broader private-context rule above.
context/private_source_documents/
context/original_chat_logs/

# Internal/private documentation and repository administration prepared for the
# original private project. Publish only a separately reviewed, sanitized set.
/docs/
/.github/README.md
/START_HERE.md
/PROJECT_STATUS.md
/CURRENT_TASK.md

